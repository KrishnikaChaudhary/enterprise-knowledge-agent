# Copy to .env (git-ignored). Everything is optional: defaults run fully offline with a mock model.
KB_LLM=mock                       # mock | gemini
# --- real Gemini (AI Studio) ---
# KB_LLM=gemini
# GEMINI_API_KEY=
# --- real Gemini (Vertex AI; on Cloud Run no key is needed) ---
# KB_GEMINI_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# --- models and prices are required for gemini (USD per 1M tokens: input,output) ---
# KB_MODEL_SMALL=
# KB_MODEL_LARGE=
# KB_EMBED_MODEL=
# KB_EMBED_DIM=768
# KB_PRICE_SMALL=
# KB_PRICE_LARGE=
# --- service ---
# KB_TOKENS=tok-employee=employee,tok-hr=hr   # bearer token -> role; required off loopback outside Cloud Run
KB_DEFAULT_ROLE=employee
KB_CORPUS_DIR=data/corpus
KB_DB=kb.db
KB_MAX_COST_USD=0.10
KB_MAX_LLM_CALLS=8
